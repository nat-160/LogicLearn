# Settings built into the site. `npm run build` makes the live site (from main) with
# these values; `npm run build:dev` makes the test version (from the dev branch) with the
# values in .env.dev-branch instead. Nothing here is secret: it ends up in the public site.

# Start of every name LogicLearn saves in the browser (progress, work, settings).
VITE_STORAGE_PREFIX=logiclearn:

# "live" for the real site, "dev" for the test version (which shows a banner).
VITE_SITE=live
