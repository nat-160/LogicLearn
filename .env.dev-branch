# The test version: built from the dev branch and published at
# https://nat-160.github.io/LogicLearn/dev/ (npm run build:dev).
#
# It runs on the same web address as the live site, so the browser would let the two
# share saved data. It saves under its own names instead, so testing never changes a
# student's progress, work or settings on the live site.
VITE_STORAGE_PREFIX=logiclearn-dev:
VITE_SITE=dev
